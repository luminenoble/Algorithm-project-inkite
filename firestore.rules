rules_version = '2';

// Inkite — Firestore 安全规则基线（T1.4 阶段 0 dev 版）
//
// 设计原则（与 docs/schema-design/design.md「安全规则要点」对齐）：
//   - 鉴权：所有读写默认要登录；公开 story 由 visibility 字段决定可读性
//   - 所有权：用户只能写自己拥有的资源；点赞用 uid 作文档 ID 保证幂等
//   - 计数：likeCount / commentCount / hotScore 仅 Cloud Functions 可写
//     （前端 update 时不能动这些字段）
//   - 运营资源：challenges / origami / charactersCache 客户端只读，
//     由 Console 或 CF 写入
//
// T1.10 会进一步收紧：限制 schema 字段、限制 visibility 枚举、
// 删除 _probe 集合规则、加入字段类型/长度校验。
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 工具函数
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 写入时，判断这些 CF-only 字段是否被前端动过
    function counterFieldsUntouched() {
      return !(
        request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['likeCount', 'commentCount', 'hotScore'])
      );
    }

    // create 时禁止前端自行设置非零计数（必须从 0 起步，由 CF 增量）
    function counterFieldsZeroOnCreate() {
      return request.resource.data.get('likeCount', 0) == 0
          && request.resource.data.get('commentCount', 0) == 0
          && request.resource.data.get('hotScore', 0) == 0;
    }

    // T6：写 story 时校验其 storybookId 指向的故事书属于本人。
    // 规则里的 get()/exists() 不受安全规则约束，可直读真实 ownerId。
    function storybookOwned(sbId) {
      return exists(/databases/$(database)/documents/storybooks/$(sbId))
        && get(/databases/$(database)/documents/storybooks/$(sbId)).data.ownerId
             == request.auth.uid;
    }
    // 防御性：迁移前旧 story 可能不带 storybookId，缺字段时放行（不强制）；
    // 一旦带了就必须指向本人故事书。chapterName 带了须为 string。
    function storyStorybookOk() {
      return !('storybookId' in request.resource.data)
        || storybookOwned(request.resource.data.storybookId);
    }
    function storyChapterOk() {
      return !('chapterName' in request.resource.data)
        || request.resource.data.chapterName is string;
    }

    // ============================================================
    // users/{uid} —— 用户档案
    // ============================================================
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // ============================================================
    // challenges/{challengeId} —— 官方挑战，客户端只读
    // ============================================================
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ============================================================
    // stories/{storyId} —— 故事
    // ============================================================
    match /stories/{storyId} {

      // get（单文档）：public 或本人
      allow get: if isSignedIn() && (
        resource.data.visibility == 'public'
        || request.auth.uid == resource.data.authorId
      );
      // list（集合查询）：已登录即可；
      // 实际数据隔离由 client query 的 where 条件保证
      // （广场: visibility=public；我的故事: authorId=uid）
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && counterFieldsZeroOnCreate()
        && storyStorybookOk()
        && storyChapterOk();

      allow update: if isSignedIn()
        && resource.data.authorId == request.auth.uid
        && counterFieldsUntouched()
        && storyStorybookOk()
        && storyChapterOk();

      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      // --------------------------------------------------------
      // stories/{storyId}/comments/{commentId} —— 评论子集合
      // --------------------------------------------------------
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid;
        allow update: if false;  // MVP 不允许编辑评论
        allow delete: if isSignedIn()
          && resource.data.authorId == request.auth.uid;
      }

      // --------------------------------------------------------
      // stories/{storyId}/likes/{likeUid} —— 点赞子集合
      // 文档 ID = uid，操作者必须就是该 uid，自动幂等
      // --------------------------------------------------------
      match /likes/{likeUid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(likeUid);
        allow update: if false;
      }
    }

    // ============================================================
    // storybooks/{storybookId} —— 故事书元数据（T6，私有组织视图）
    //   - 读：仅 owner（故事书不对外公开）
    //   - coverUrl 仅 CF（uploadStorybookCover, Admin SDK）可写，前端禁动
    //   - 默认书（isDefault==true）禁改名、禁删
    // ============================================================
    match /storybooks/{storybookId} {
      // resource == null：允许 get() 一个尚不存在的默认书（getOrCreateDefault
      // 的存在性检查）。Firestore 对不存在文档的 get 会以 resource=null 评估，
      // 直接解引用 resource.data 会因 null 而拒绝，故须显式放行。
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid == resource.data.ownerId);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.isDefault is bool
        && request.resource.data.pinned is bool
        && !('coverUrl' in request.resource.data);

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['coverUrl', 'ownerId', 'isDefault', 'createdAt'])
        && (resource.data.isDefault == false
            || request.resource.data.title == resource.data.title);

      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.isDefault == false;
    }

    // ============================================================
    // origami/{origamiId} —— AI 折纸藏品实例
    // 仅 Cloud Function `generateOrigami` 写，客户端只读
    // ============================================================
    match /origami/{origamiId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ============================================================
    // charactersCache/{characterKey} —— 模块 G 角色查询缓存
    // 由模块 G 后端或 Cloud Function 写，客户端只读
    // ============================================================
    match /charactersCache/{characterKey} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ============================================================
    // _probe/{uid} —— T1.3 端到端连通性探针
    // 仅本人对自己 uid 文档可读写；T1.10 收紧规则时移除
    // ============================================================
    match /_probe/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ============================================================
    // 兜底：未声明集合一律拒绝
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
